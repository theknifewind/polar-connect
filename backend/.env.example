# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./polar_connect.db

# ─── LLM — Groq (Primary) ───────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LLM — OpenRouter (optional) ────────────────────────────
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Polar Connect

# ─── LLM — Gemini (Fallback) ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Auth ────────────────────────────────────────────────────
ADMIN_SECRET_KEY=change-me-to-a-random-string

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMADB_DIR=./chromadb_data

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Default Admin (created by seed runner) ──────────────────
ADMIN_EMAIL=admin@ncpor.res.in
ADMIN_PASSWORD=PolarConnect2026!
